{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "__FRAMEWORK_PATH__/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "__FRAMEWORK_PATH__/hooks/stop-guard.sh"
          }
        ]
      }
    ]
  }
}
