#!/usr/bin/env bash
# Rewrite ONE review report into the compact author+PM-facing version (verdict + findings + 'In plain words').
# Shared by `prctl optimize` and pr-review-run's auto-optimize. usage: pr-optimize <report.md>
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/pr-lib.sh"
require_db

path="${1:?report path required}"
[[ -f "$path" ]] || { echo "no report at $path" >&2; exit 1; }
opt="${path%.md}-opt.md"
model="${CTF_PR_CLAUDE_MODEL:-$(setting_get model)}"; model="${model:-claude-sonnet-5}"
content="$(cat "$path")"
echo "optimizing $(basename "$path") with $model …" >&2
env -u CLAUDECODE -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_ENTRYPOINT \
  claude --dangerously-skip-permissions -p --model "$model" \
  "Rewrite this PR review report into a compact version for the PR author.
KEEP: the **Verdict:** line verbatim, the summary, and every concrete finding with its file:line and the required fix.
REMOVE ENTIRELY: sections or paragraphs reporting that nothing was found; validator/process narration (rounds, who confirmed what); 'False Positives Removed', 'Dropped as defensive', and 'Missed in Round 1' sections unless they contain a surviving actionable finding; restatements and praise; process asks that are not code defects (requests to explain intent, empty-PR-body complaints, TDD/missing-test compliance notes) — drop such findings even if numbered, and recompute the summary from what remains.
Tighten the wording of what remains. Keep markdown; keep tables only where they carry findings, and compress verbose cells.
ADD a final column named 'In plain words' to every findings table: 1-2 sentences per finding written for a smart product manager with zero engineering background — what actually goes wrong for the user or the business, and why it matters. Rules for that column: zero unexplained jargon (translate inline on first use); no code, file paths, or acronyms; consequences not mechanisms ('checkout could charge twice', never 'race condition'); quantify in PM units (users affected, revenue, days) not ms/MB/lines; an everyday analogy is welcome when it carries the mechanism; not condescending.
After the Summary line, add one final line 'In plain words:' restating the overall verdict the same way (2-3 sentences max).
Output ONLY the rewritten markdown — no preamble, no commentary.

$content" > "$opt.tmp" || { rm -f "$opt.tmp"; echo "optimize failed (claude exited non-zero)" >&2; exit 1; }
if [[ ! -s "$opt.tmp" ]] || ! grep -q '\*\*Verdict:\*\*' "$opt.tmp"; then
  rm -f "$opt.tmp"; echo "optimize failed (empty or no Verdict line in output)" >&2; exit 1
fi
mv "$opt.tmp" "$opt"
echo "optimized → $opt"
