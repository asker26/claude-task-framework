PAGE = r"""<!doctype html><html lang="en"><head><meta charset="utf-8"><title>PR cockpit</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>__CSS__</style><script>(function(){var t=localStorage.getItem('prc-theme');if(t)document.documentElement.setAttribute('data-theme',t)})();function toggleTheme(){var cur=document.documentElement.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');var n=cur==='dark'?'light':'dark';localStorage.setItem('prc-theme',n);document.documentElement.setAttribute('data-theme',n)}</script></head><body>
<header><h1>PR cockpit · <span id="org"></span></h1><span class="dim" id="hdr">…</span><span class="grow"></span>
<button onclick="toggleTheme()" title="light / dark">☀/☾</button>
<button onclick="act({action:'sync'})">Sync</button>
<button id="wbtn" onclick="workerToggle()">Worker</button>
<button onclick="act({action:'worker',mode:'start-queue'})" title="run only what was queued">Start queue-only</button>
<span class="dim small" id="clock"></span></header>
<main>
<section id="left">
 <div id="running"></div>
 <h2>Staged — read &amp; post</h2><div id="staged"></div>
 <h2>Queue</h2><div id="queue" class="small"></div>
 <h2>Board</h2><div id="board"></div>
 <h2>Sessions</h2><div id="sessions" class="small"></div>
 <h2>Last 48h</h2><div id="history" class="hist"></div>
</section>
<section id="report"><div class="small">Click a PR ref to open its report (staged or posted).</div></section>
</main>
<div class="toast" id="toast"></div>
<script>
let S=null, sel=null;
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function toast(t){const e=document.getElementById('toast');e.textContent=t;e.style.display='block';clearTimeout(e._t);e._t=setTimeout(()=>e.style.display='none',6000)}
async function act(p){toast('… '+p.action+(p.ref?' '+p.ref:''));const r=await fetch('/api/action',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});const j=await r.json();toast((j.ok?'✓ ':'✗ ')+j.output);await load();if(sel)openReport(sel)}
function workerToggle(){act({action:'worker',mode:S&&S.worker_running?'stop':'start'})}
function tags(b){let t='';if(b.stale)t+='<span class="tag stale">STALE</span>';if(b.conflicts)t+='<span class="tag red">conflicts</span>';if(b.ci_red)t+='<span class="tag red">ci-red</span>';if(b.checks==='SUCCESS'&&(b.status==='approved'||b.status==='mine'))t+='<span class="tag ok">green</span>';if(b.too_big)t+='<span class="tag">too-big</span>';if(b.claims)t+='<span class="tag claim">s:'+esc(b.claims)+'</span>';return t}
function stext(b){if(b.status==='staged')return 'staged '+(b.active_review_verdict||'?')+(b.active_review_behind?' (behind)':'');if(b.status==='waiting-author')return 'waiting '+b.waiting_days+'d';if(b.status==='approved')return b.ready?'ready ✓':'approved';if(b.status==='mine')return b.ready?'ready ✓':(b.review_decision||'no-review').toLowerCase();return b.status}
function mergeBtn(b){return `<button class="danger" onclick="event.stopPropagation();if(confirm('Merge ${b.ref} on GitHub?'))act({action:'merge',ref:'${b.ref}'})">merge</button> `}
function rowBtns(b){let h='';if((b.status==='approved'||b.status==='mine')&&b.ready)h+=mergeBtn(b);if(b.status==='staged')h+=`<button class="primary" onclick="event.stopPropagation();openReport('${b.ref}')">read</button> `;if(['needs-review','re-review','author-replied','review-failed','commented','waiting-author','approved'].includes(b.status))h+=`<button onclick="event.stopPropagation();act({action:'review',ref:'${b.ref}'})">queue review</button> `;if(b.status==='skipped')h+=`<button onclick="event.stopPropagation();act({action:'unskip',ref:'${b.ref}'})">unskip</button> `;else if(b.status!=='mine')h+=`<button onclick="event.stopPropagation();act({action:'skip',ref:'${b.ref}',days:7})">skip 7d</button>`;return h}
const gh=b=>b.url?`<a class="gh" href="${esc(b.url)}" target="_blank" title="open on GitHub" onclick="event.stopPropagation()">↗</a>`:'';
function section(title,items){if(!items.length)return '';return `<h2>${title}</h2><table class="board">`+items.map(b=>`<tr class="${sel===b.ref?'sel':''}" onclick="openReport('${b.ref}')"><td><span class="ref">${esc(b.ref)}</span> ${gh(b)}</td><td class="status st-${b.status}">${esc(stext(b))}</td><td>${b.age_days}d</td><td>${esc(b.author||'')}</td><td>${tags(b)}</td><td class="title">${esc(b.title||'')}</td><td>${rowBtns(b)}</td></tr>`).join('')+'</table>'}
function render(){if(!S)return;document.getElementById('org').textContent=S.org;document.getElementById('clock').textContent=S.now;
 document.getElementById('hdr').textContent=`synced ${S.synced_min==null?'?':S.synced_min}m ago · worker: ${S.worker} · model ${S.model}`;
 document.getElementById('wbtn').textContent=S.worker_running?'Stop worker':'Start worker (auto)';
 document.getElementById('running').innerHTML=S.running.length?S.running.map(r=>`<div class="card run"><b>RUNNING</b> <span class="ref" onclick="openLog('${r.ref}')">${esc(r.ref)}</span> · ${r.mins}m · agents ${r.agents} · heartbeat ${r.hb_s}s ago<div class="act">${esc(r.last_action||'')}</div></div>`).join(''):'<div class="card small">worker idle — nothing running</div>';
 document.getElementById('staged').innerHTML=S.staged.length?`<table class="board">`+S.staged.map(s=>`<tr class="${sel===s.ref?'sel':''}" onclick="openReport('${s.ref}')"><td><span class="ref">${esc(s.ref)}</span> ${gh(s)}</td><td class="status st-staged">${esc(s.verdict||'?')}${s.behind?' (behind)':''}</td><td>${s.mins_ago}m ago</td><td>${esc(s.author||'')}</td><td class="title">${esc(s.title||'')}</td><td><button class="primary" onclick="event.stopPropagation();openReport('${s.ref}')">read</button> <a href="/report?ref=${encodeURIComponent(s.ref)}" target="_blank" onclick="event.stopPropagation()"><button>full page ↗</button></a></td></tr>`).join('')+'</table>':'<div class="small">nothing staged</div>';
 document.getElementById('queue').innerHTML=S.queue.length?S.queue.map(q=>`<div><span class="ref" onclick="openReport('${q.ref}')">${esc(q.ref)}</span> queued ${q.mins}m ago${q.attempts?' · attempt '+(q.attempts+1):''} <button onclick="act({action:'discard',ref:'${q.ref}',reason:'dequeued from UI'})">dequeue</button></div>`).join(''):'(empty)';
 const by=st=>S.board.filter(b=>st.includes(b.status));
 document.getElementById('board').innerHTML=section('Needs you',by(['running','staged','review-failed','re-review','author-replied','needs-review']))+section('Waiting on author',by(['waiting-author','commented']))+section('Approved',by(['approved']))+section('Mine',by(['mine']))+section('Skipped',by(['skipped']))+section('Drafts',by(['draft']));
 document.getElementById('sessions').innerHTML=S.sessions.length?S.sessions.map(s=>`<div><b>${esc(s.label||s.id)}</b> <span class="tag">${esc(s.kind)}</span> ${esc(s.repo||'')} ${s.claims?'· claims '+esc(s.claims):''} <span class="dim">· seen ${esc(s.last_seen_at.slice(11,16))}</span></div>`).join(''):'(none live)';
 document.getElementById('history').innerHTML=S.history.length?S.history.map(h=>`<div>${esc((h.finished_at||h.started_at||'').slice(5,16))} <b>${esc(h.ref)}</b> ${esc(h.status)} ${esc(h.verdict||'')} ${h.took!=null?h.took+'m':''} ${h.error?'— '+esc(h.error.slice(0,80)):''}</div>`).join(''):'(nothing yet)'}
async function load(){try{S=await (await fetch('/api/state')).json();render()}catch(e){document.getElementById('hdr').textContent='server unreachable'}}
function closeReport(){sel=null;document.querySelector('main').classList.remove('split');render()}
async function openReport(ref,view){sel=ref;render();document.querySelector('main').classList.add('split');const r=await (await fetch('/api/report?ref='+encodeURIComponent(ref)+(view?'&view='+view:''))).json();const el=document.getElementById('report');
 if(r.error){el.innerHTML=`<div class="card"><b>${esc(ref)}</b>${r.url?` · <a href="${esc(r.url)}" target="_blank" style="color:var(--acc)">${esc(r.title||'open on GitHub')} ↗</a>`:''}${r.author?` · ${esc(r.author)}`:''}${r.status?` · <span class="status st-${esc(r.status)}">${esc(r.status)}</span>`:''}<br><span class="small">${esc(r.error)}</span>
 <div class="actions"><button class="primary" onclick="act({action:'review',ref:'${ref}'})">queue review</button> <button onclick="openLog('${ref}')">session log</button> <button onclick="closeReport()">close</button></div></div>`;return}
 const canPost=r.status==='staged';const v=r.verdict||'';
 el.innerHTML=`<div class="card"><b>${esc(r.ref)}</b> · <a href="${esc(r.url)}" target="_blank" style="color:var(--acc)">${esc(r.title||'')}</a> · ${esc(r.author||'')}<br>
 <span class="small">review ${r.id} · ${esc(r.status)} · verdict <b>${esc(v||'unparsed')}</b> · reviewed ${esc((r.head_sha||'').slice(0,7))}${r.behind?' <span class="tag stale">behind head '+esc((r.pr_head||'').slice(0,7))+'</span>':''}${r.has_optimized?' · viewing <b>'+r.view+'</b>':''} · ${esc((r.finished_at||''))}</span>
 <div class="actions">${canPost?`<label class="small">post as <select id="vsel"><option value="">${esc(v||'unparsed → comment')}</option><option value="A">approve</option><option value="RC">request changes</option><option value="C">comment</option></select></label>
 <label class="small"><input type="checkbox" id="vfull"> full report</label>
 ${r.has_optimized?`<label class="small"><input type="checkbox" id="vopt" ${r.view==='optimized'?'checked':''}> post optimized</label>`:''}
 <button class="primary" onclick="postIt('${r.ref}')">Post to GitHub</button>
 <button class="danger" onclick="if(confirm('Discard this report?'))act({action:'discard',ref:'${r.ref}'})">Discard</button>`:''}
 <button onclick="act({action:'review',ref:'${r.ref}'})">Re-review</button>
 ${r.has_optimized?`<button onclick="openReport('${r.ref}','${r.view==='optimized'?'original':'optimized'}')">view ${r.view==='optimized'?'original':'optimized'}</button> <button onclick="act({action:'optimize',ref:'${r.ref}'})">Re-optimize</button>`:`<button onclick="act({action:'optimize',ref:'${r.ref}'})">Optimize</button>`}
 <button onclick="openLog('${r.ref}')">Session log</button> <a href="/report?ref=${encodeURIComponent(r.ref)}" target="_blank"><button>Full page ↗</button></a>
 <button class="danger" onclick="mergeIt('${r.ref}')">Merge PR</button> <label class="small"><input type="checkbox" id="madmin"> admin</label>
 <button onclick="closeReport()">Close</button></div></div>
 <div class="body">${r.html}</div>`}
function mergeIt(ref){const a=document.getElementById('madmin');if(!confirm('Merge '+ref+' on GitHub'+(a&&a.checked?' (admin)':'')+'?'))return;act({action:'merge',ref,admin:!!(a&&a.checked)})}
function postIt(ref){const v=document.getElementById('vsel').value,full=document.getElementById('vfull').checked,o=document.getElementById('vopt');if(!confirm('Post this review to GitHub under your account?'))return;act({action:'post',ref,verdict:v||undefined,full,optimized:!!(o&&o.checked)})}
async function openLog(ref){sel=ref;document.querySelector('main').classList.add('split');const t=await (await fetch('/api/log?ref='+encodeURIComponent(ref))).text();document.getElementById('report').innerHTML=`<div class="card"><b>${esc(ref)}</b> · session log (last 200 events) <button onclick="openLog('${ref}')">refresh</button> <button onclick="openReport('${ref}')">report</button> <button onclick="closeReport()">close</button></div><pre class="body" style="white-space:pre-wrap;font-size:12px">${esc(t)}</pre>`}
load();setInterval(load,10000);
</script></body></html>"""


REPORT_PAGE = r"""<!doctype html><html lang="en"><head><meta charset="utf-8"><title>__TITLE__</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>__CSS__ .wrap{max-width:1500px;margin:0 auto;padding:16px}#report{display:block}#report .body{font-size:14px}#report .body p,#report .body li{max-width:none}</style><script>(function(){var t=localStorage.getItem('prc-theme');if(t)document.documentElement.setAttribute('data-theme',t)})();function toggleTheme(){var cur=document.documentElement.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');var n=cur==='dark'?'light':'dark';localStorage.setItem('prc-theme',n);document.documentElement.setAttribute('data-theme',n)}</script></head><body>
<header><h1><a href="/" style="color:var(--fg);text-decoration:none">PR cockpit</a> · <span class="dim">report</span></h1><span class="grow"></span><button onclick="toggleTheme()" title="light / dark">☀/☾</button></header>
<div class="wrap" id="report">__CARD__<div class="body">__HTML__</div></div>
<div class="toast" id="toast"></div>
<script>
const REF=__REF__;
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function toast(t){const e=document.getElementById('toast');e.textContent=t;e.style.display='block';clearTimeout(e._t);e._t=setTimeout(()=>e.style.display='none',8000)}
async function act(p){toast('… '+p.action+' '+(p.ref||''));const r=await fetch('/api/action',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});const j=await r.json();toast((j.ok?'✓ ':'✗ ')+j.output);if(j.ok)setTimeout(()=>location.reload(),1200)}
function postIt(){const v=document.getElementById('vsel').value,full=document.getElementById('vfull').checked,o=document.getElementById('vopt');if(!confirm('Post this review to GitHub under your account?'))return;act({action:'post',ref:REF,verdict:v||undefined,full,optimized:!!(o&&o.checked)})}
function mergeIt(){const a=document.getElementById('madmin');if(!confirm('Merge '+REF+' on GitHub'+(a&&a.checked?' (admin)':'')+'?'))return;act({action:'merge',ref:REF,admin:!!(a&&a.checked)})}
</script></body></html>"""


def report_page(ref, view=""):
    r = report(ref, view)
    if r.get("error") and not r.get("markdown"):
        card = (f'<div class="card"><b>{html.escape(ref)}</b>'
                + (f' · <a href="{html.escape(r["url"])}" target="_blank" style="color:var(--acc)">{html.escape(r.get("title") or "open on GitHub")} ↗</a>' if r.get("url") else "")
                + f'<br><span class="small">{html.escape(r["error"])}</span>'
                + f'<div class="actions"><button class="primary" onclick="act({{action:\'review\',ref:REF}})">queue review</button> <a href="/"><button>back to cockpit</button></a></div></div>')
        body = ""
    else:
        v = r.get("verdict") or ""
        can_post = r.get("status") == "staged"
        behind = f' <span class="tag stale">behind head {html.escape((r.get("pr_head") or "")[:7])}</span>' if r.get("behind") else ""
        actions = ""
        if can_post:
            actions += (f'<label class="small">post as <select id="vsel"><option value="">{html.escape(v or "unparsed → comment")}</option>'
                        '<option value="A">approve</option><option value="RC">request changes</option><option value="C">comment</option></select></label> '
                        '<label class="small"><input type="checkbox" id="vfull"> full report</label> '
                        '<button class="primary" onclick="postIt()">Post to GitHub</button> '
                        '<button class="danger" onclick="if(confirm(\'Discard this report?\'))act({action:\'discard\',ref:REF})">Discard</button> ')
        if r.get("has_optimized"):
            other = "original" if r.get("view") == "optimized" else "optimized"
            actions += f'<a href="/report?ref={html.escape(ref)}&view={other}"><button>view {other}</button></a> '
            actions += '<button onclick="act({action:\'optimize\',ref:REF})">Re-optimize</button> '
            if can_post:
                actions += '<label class="small"><input type="checkbox" id="vopt" checked> post optimized</label> '
        else:
            actions += '<button onclick="act({action:\'optimize\',ref:REF})">Optimize</button> '
        actions += ('<button class="danger" onclick="mergeIt()">Merge PR</button> <label class="small"><input type="checkbox" id="madmin"> admin</label> '
                    '<button onclick="act({action:\'review\',ref:REF})">Re-review</button> <a href="/"><button>back to cockpit</button></a>')
        viewing = f' · viewing <b>{r["view"]}</b>' if r.get("has_optimized") else ""
        card = (f'<div class="card"><b>{html.escape(r["ref"])}</b> · <a href="{html.escape(r.get("url") or "#")}" target="_blank" style="color:var(--acc)">{html.escape(r.get("title") or "")} ↗</a> · {html.escape(r.get("author") or "")}<br>'
                f'<span class="small">review {r["id"]} · {html.escape(r["status"])} · verdict <b>{html.escape(v or "unparsed")}</b> · reviewed {html.escape((r.get("head_sha") or "")[:7])}{behind}{viewing} · {html.escape(r.get("finished_at") or "")}</span>'
                f'<div class="actions">{actions}</div></div>')
        body = r["html"]
    return (REPORT_PAGE.replace("__CSS__", CSS).replace("__TITLE__", html.escape(f"{ref} · report"))
            .replace("__CARD__", card).replace("__HTML__", body).replace("__REF__", json.dumps(ref)))


def log_text(ref):
    m = re.match(r"^(?:([\w.-]+)/)?([\w.-]+)#(\d+)$", ref or "")
    if not m:
        return "bad ref"
    repo = f"{m.group(1) or ORG}/{m.group(2)}"
    path = scalar("SELECT r.log_path FROM pr_reviews r JOIN prs p ON p.id = r.pr_id WHERE p.repo = ? COLLATE NOCASE AND p.number = ? AND r.log_path IS NOT NULL "
                  "ORDER BY CASE r.status WHEN 'running' THEN 0 ELSE 1 END, r.id DESC LIMIT 1", (repo, int(m.group(3))))
    if not path:
        return "no session log"
    out = []
    for line in stream_tail(path, 200):
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") == "system" and ev.get("subtype") == "init":
            out.append(f"[init] model {ev.get('model')} session {ev.get('session_id')}")
        elif ev.get("type") == "assistant":
            for c in ev.get("message", {}).get("content", []) or []:
                if c.get("type") == "tool_use":
                    inp = c.get("input", {}) or {}
                    desc = inp.get("description") or inp.get("skill") or inp.get("command") or inp.get("prompt") or inp.get("file_path") or ""
                    out.append(f"→ {c.get('name')}: {str(desc).replace(chr(10), ' ')[:200]}")
                elif c.get("type") == "text" and c.get("text"):
                    out.append("… " + c["text"].replace("\n", " ")[:300])
        elif ev.get("type") == "result":
            out.append(f"[result] {ev.get('subtype')} · {str(ev.get('result', ''))[:300]}")
    return "\n".join(out) or "(no events yet)"


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        if os.environ.get("PR_SERVE_LOG"):
            super().log_message(fmt, *args)

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body if isinstance(body, bytes) else (json.dumps(body) if ctype.startswith("application/json") else body).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        u = urlparse(self.path)
        q = parse_qs(u.query)
        try:
            if u.path == "/":
                self._send(200, PAGE.replace("__CSS__", CSS), "text/html; charset=utf-8")
            elif u.path == "/report":
                self._send(200, report_page(q.get("ref", [""])[0], q.get("view", [""])[0]), "text/html; charset=utf-8")
            elif u.path == "/api/state":
                self._send(200, state())
            elif u.path == "/api/report":
                self._send(200, report(q.get("ref", [""])[0], q.get("view", [""])[0]))
            elif u.path == "/api/log":
                self._send(200, log_text(q.get("ref", [""])[0]), "text/plain; charset=utf-8")
            else:
                self._send(404, {"error": "not found"})
        except Exception as e:  # keep the page alive on any single failure
            self._send(500, {"error": str(e)})

    def do_POST(self):
        u = urlparse(self.path)
        if u.path != "/api/action":
            return self._send(404, {"error": "not found"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            payload = json.loads(self.rfile.read(n) or b"{}")
        except ValueError:
            return self._send(400, {"ok": False, "output": "bad json"})
        code, body = run_action(payload)
        self._send(code, body)


def main():
    host, port = "127.0.0.1", 7787
    args = sys.argv[1:]
    while args:
        a = args.pop(0)
        if a == "--port":
            port = int(args.pop(0))
        elif a == "--host":
            host = args.pop(0)
        else:
            print(__doc__); sys.exit(1)
    if not os.path.exists(DB):
        print(f"tasks.db not found at {DB}", file=sys.stderr); sys.exit(1)
    srv = ThreadingHTTPServer((host, port), Handler)
    print(f"PR cockpit UI listening on http://{host}:{srv.server_address[1]}", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
