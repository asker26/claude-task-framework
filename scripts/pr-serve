#!/usr/bin/env python3
"""Local web UI for the PR cockpit: board, live worker status, rendered reports, one-click prctl actions.
Reads tasks.db directly; every mutation goes through `prctl` so the CLI stays the single source of truth.
usage: pr-serve [--port N] [--host 127.0.0.1]   (prctl serve wraps this)
"""
import html
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DB = os.environ.get("TASK_DB_PATH", os.path.join(ROOT, "tasks.db"))
PRCTL = os.path.join(ROOT, "scripts", "prctl")
ORG = os.environ.get("CTF_PR_ORG", "FS-Code")
TMUX_SESSION = os.environ.get("CTF_TMUX_SESSION", "ctf-agents")

ACTIONS = {  # action → prctl argv builder (only these are reachable from the page)
    "post":     lambda p: ["post", p["ref"], "--yes"] + (["--verdict", p["verdict"]] if p.get("verdict") else []) + (["--full"] if p.get("full") else []) + (["--optimized"] if p.get("optimized") else []),
    "discard":  lambda p: ["discard", p["ref"], "--reason", p.get("reason") or "discarded from UI"],
    "review":   lambda p: ["review", p["ref"]],
    "optimize": lambda p: ["optimize", p["ref"]],
    "merge":    lambda p: ["merge", p["ref"], "--yes"] + (["--admin"] if p.get("admin") else []),
    "skip":     lambda p: ["skip", p["ref"]] + (["--days", str(int(p["days"]))] if p.get("days") else []),
    "unskip":   lambda p: ["unskip", p["ref"]],
    "sync":     lambda p: ["sync"],
    "worker":   lambda p: ["worker", {"start": "start", "start-queue": "start", "stop": "stop"}[p["mode"]]] + (["--queue-only"] if p["mode"] == "start-queue" else []),
}


def db():
    con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=5)
    con.row_factory = sqlite3.Row
    return con


def rows(sql, args=()):
    with db() as con:
        return [dict(r) for r in con.execute(sql, args).fetchall()]


def scalar(sql, args=()):
    with db() as con:
        r = con.execute(sql, args).fetchone()
        return r[0] if r else None


def setting(key):
    return scalar("SELECT value FROM pr_settings WHERE key = ?", (key,))


def short_ref(repo, number):
    return f"{repo.split('/', 1)[1]}#{number}"


def worker_running():
    try:
        out = subprocess.run(["tmux", "list-windows", "-t", TMUX_SESSION, "-F", "#{window_name}"],
                             capture_output=True, text=True, timeout=3).stdout
        return "pr-worker" in out.split()
    except Exception:
        return False


def worker_state():
    if not worker_running():
        return "stopped"
    until = setting("worker_cooldown_until")
    if until and scalar("SELECT datetime('now') < ?", (until,)):
        return f"cooldown until {until[11:16]} UTC (session cap)"
    run = rows("SELECT p.repo, p.number, CAST((julianday('now') - julianday(r.started_at)) * 1440 AS INTEGER) AS mins "
               "FROM pr_reviews r JOIN prs p ON p.id = r.pr_id WHERE r.status = 'running' ORDER BY r.started_at")
    if run:
        return "reviewing " + ", ".join(f"{short_ref(x['repo'], x['number'])} ({x['mins']}m)" for x in run)
    mode = setting("worker_mode")
    return f"idle ({mode})" if mode in ("sync-only", "queue-only") else "idle"


def stream_tail(path, n=60):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - 200_000))
            lines = f.read().decode("utf-8", "replace").splitlines()[-n:]
    except OSError:
        return []
    return lines


def count_agents(path):
    try:
        with open(path, "rb") as f:
            return f.read().count(b'"name":"Agent"')
    except OSError:
        return 0


def last_action(path):
    act, agents = "", count_agents(path)
    for line in stream_tail(path, 400):
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") != "assistant":
            continue
        for c in ev.get("message", {}).get("content", []) or []:
            if c.get("type") == "tool_use":
                inp = c.get("input", {}) or {}
                desc = inp.get("description") or inp.get("skill") or inp.get("command") or inp.get("prompt") or inp.get("file_path") or ""
                act = f"→ {c.get('name')}: {str(desc).replace(chr(10), ' ')[:120]}"
            elif c.get("type") == "text" and c.get("text"):
                act = "… " + c["text"].replace("\n", " ")[:120]
    return act, agents


def state():
    last = setting("last_sync_at")
    synced_min = scalar("SELECT CAST((julianday('now') - julianday(?)) * 1440 AS INTEGER)", (last,)) if last else None
    running = rows("SELECT r.id, p.repo, p.number, r.started_at, r.log_path, "
                   "CAST((julianday('now') - julianday(r.started_at)) * 1440 AS INTEGER) AS mins, "
                   "CAST((julianday('now') - julianday(r.heartbeat_at)) * 86400 AS INTEGER) AS hb_s "
                   "FROM pr_reviews r JOIN prs p ON p.id = r.pr_id WHERE r.status = 'running' ORDER BY r.started_at")
    for r in running:
        r["ref"] = short_ref(r["repo"], r["number"])
        r["last_action"], r["agents"] = last_action(r["log_path"]) if r.get("log_path") else ("", 0)
    board = rows("SELECT repo, number, title, author, url, status, stale, ready, conflicts, ci_red, too_big, "
                 "age_days, waiting_days, checks, review_decision, claims, active_review_verdict, active_review_behind, "
                 "additions, deletions, changed_files, skip_until FROM pr_board ORDER BY stale DESC, age_days DESC, repo, number")
    for b in board:
        b["ref"] = short_ref(b["repo"], b["number"])
    queue = rows("SELECT r.id, p.repo, p.number, r.attempts, CAST((julianday('now') - julianday(r.queued_at)) * 1440 AS INTEGER) AS mins "
                 "FROM pr_reviews r JOIN prs p ON p.id = r.pr_id WHERE r.status = 'queued' ORDER BY r.queued_at, r.id")
    for q in queue:
        q["ref"] = short_ref(q["repo"], q["number"])
    staged = rows("SELECT r.id, p.repo, p.number, p.title, p.url, r.verdict, (r.head_sha <> p.head_sha) AS behind, r.finished_at, "
                  "CAST((julianday('now') - julianday(r.finished_at)) * 60 AS INTEGER) AS mins_ago, p.author "
                  "FROM pr_reviews r JOIN prs p ON p.id = r.pr_id WHERE r.status = 'staged' ORDER BY r.finished_at DESC")
    for s in staged:
        s["ref"] = short_ref(s["repo"], s["number"])
    history = rows("SELECT r.id, p.repo, p.number, r.status, r.verdict, r.attempts, r.error, r.started_at, r.finished_at, r.posted_at, "
                   "CASE WHEN r.started_at IS NOT NULL AND r.finished_at IS NOT NULL THEN CAST((julianday(r.finished_at) - julianday(r.started_at)) * 1440 AS INTEGER) END AS took "
                   "FROM pr_reviews r JOIN prs p ON p.id = r.pr_id WHERE r.status IN ('staged','posted','failed','discarded') "
                   "AND COALESCE(r.finished_at, r.started_at) > datetime('now', '-2 days') ORDER BY COALESCE(r.finished_at, r.started_at) DESC LIMIT 40")
    for h in history:
        h["ref"] = short_ref(h["repo"], h["number"])
    sessions = rows("SELECT substr(id, 1, 8) AS id, label, kind, repo, cwd, last_seen_at, "
                    "(SELECT group_concat(substr(p.repo, instr(p.repo, '/') + 1) || '#' || p.number, ', ') FROM pr_claims c JOIN prs p ON p.id = c.pr_id "
                    " WHERE c.session_id = sessions.id AND c.released_at IS NULL) AS claims "
                    "FROM sessions WHERE ended_at IS NULL AND last_seen_at > datetime('now', '-48 hours') ORDER BY last_seen_at DESC")
    return {"org": ORG, "now": time.strftime("%H:%M:%S"), "synced_min": synced_min, "worker": worker_state(),
            "worker_running": worker_running(), "model": setting("model") or "claude-sonnet-5",
            "running": running, "queue": queue, "staged": staged, "board": board, "history": history, "sessions": sessions}


def report(ref, view=""):
    m = re.match(r"^(?:([\w.-]+)/)?([\w.-]+)#(\d+)$", ref or "")
    if not m:
        return {"error": "bad ref"}
    repo = f"{m.group(1) or ORG}/{m.group(2)}"
    r = rows("SELECT r.id, r.status, r.verdict, r.head_sha, r.report_path, r.finished_at, p.head_sha AS pr_head, p.title, p.url, p.author, p.repo, p.number "
             "FROM pr_reviews r JOIN prs p ON p.id = r.pr_id WHERE p.repo = ? COLLATE NOCASE AND p.number = ? AND r.report_path IS NOT NULL "
             "ORDER BY CASE r.status WHEN 'staged' THEN 0 WHEN 'posted' THEN 1 ELSE 2 END, r.id DESC LIMIT 1", (repo, int(m.group(3))))
    if not r:
        pr = rows("SELECT repo, number, title, url, author, state, head_sha, "
                  "(SELECT status FROM pr_board b WHERE b.repo = prs.repo AND b.number = prs.number) AS status "
                  "FROM prs WHERE repo = ? COLLATE NOCASE AND number = ?", (repo, int(m.group(3))))
        if not pr:
            return {"error": "unknown PR"}
        pr = pr[0]
        pr["ref"] = short_ref(pr["repo"], pr["number"])
        return {"error": "no report", **pr}
    r = r[0]
    try:
        with open(r["report_path"], encoding="utf-8", errors="replace") as f:
            md = f.read()
    except OSError:
        return {"error": "report file missing", **r}
    opt_path = r["report_path"][:-3] + "-opt.md"
    r["has_optimized"] = os.path.exists(opt_path)
    r["view"] = "original"
    if r["has_optimized"] and view != "original":
        try:
            with open(opt_path, encoding="utf-8", errors="replace") as f:
                md = f.read()
            r["view"] = "optimized"
        except OSError:
            pass
    r["ref"] = short_ref(r["repo"], r["number"])
    r["behind"] = r["head_sha"] != r["pr_head"]
    r["markdown"] = md
    r["html"] = md_to_html(md)
    return r


def md_to_html(md):
    """Small markdown renderer: headings, bold/italic/code, lists, tables, hr, paragraphs, fenced code."""
    out, in_ul, in_ol, in_code, table = [], False, False, False, []

    def close_lists():
        nonlocal in_ul, in_ol
        if in_ul:
            out.append("</ul>"); in_ul = False
        if in_ol:
            out.append("</ol>"); in_ol = False

    def flush_table():
        nonlocal table
        if not table:
            return
        rws = [[c.strip() for c in row.strip().strip("|").split("|")] for row in table]
        rws = [rw for rw in rws if not all(re.fullmatch(r":?-{2,}:?", c or "") for c in rw)]
        if rws:
            out.append("<table><thead><tr>" + "".join(f"<th>{inline(c)}</th>" for c in rws[0]) + "</tr></thead><tbody>")
            for rw in rws[1:]:
                out.append("<tr>" + "".join(f"<td>{inline(c)}</td>" for c in rw) + "</tr>")
            out.append("</tbody></table>")
        table = []

    def inline(t):
        t = html.escape(t)
        t = re.sub(r"`([^`]+)`", r"<code>\1</code>", t)
        t = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", t)
        t = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"<em>\1</em>", t)
        t = re.sub(r"\[([^\]]+)\]\((https?://[^)\s]+)\)", r'<a href="\2" target="_blank">\1</a>', t)
        return t

    for line in md.splitlines():
        if line.startswith("```"):
            flush_table(); close_lists()
            out.append("</pre>" if in_code else "<pre>"); in_code = not in_code; continue
        if in_code:
            out.append(html.escape(line)); continue
        if line.strip().startswith("|"):
            close_lists(); table.append(line); continue
        flush_table()
        m = re.match(r"^(#{1,6})\s+(.*)", line)
        if m:
            close_lists(); out.append(f"<h{len(m.group(1))}>{inline(m.group(2))}</h{len(m.group(1))}>"); continue
        if re.match(r"^\s*(-{3,}|\*{3,})\s*$", line):
            close_lists(); out.append("<hr>"); continue
        m = re.match(r"^\s*[-*]\s+(.*)", line)
        if m:
            if in_ol: out.append("</ol>"); in_ol = False
            if not in_ul: out.append("<ul>"); in_ul = True
            out.append(f"<li>{inline(m.group(1))}</li>"); continue
        m = re.match(r"^\s*\d+[.)]\s+(.*)", line)
        if m:
            if in_ul: out.append("</ul>"); in_ul = False
            if not in_ol: out.append("<ol>"); in_ol = True
            out.append(f"<li>{inline(m.group(1))}</li>"); continue
        close_lists()
        if line.strip():
            out.append(f"<p>{inline(line)}</p>")
    flush_table(); close_lists()
    if in_code:
        out.append("</pre>")
    return "\n".join(out)


def run_action(payload):
    action = payload.get("action")
    if action not in ACTIONS:
        return 400, {"ok": False, "output": f"unknown action {action}"}
    if action != "sync" and action != "worker" and not re.match(r"^(?:[\w.-]+/)?[\w.-]+#\d+$", payload.get("ref", "")):
        return 400, {"ok": False, "output": "bad ref"}
    if action == "post" and payload.get("verdict") not in (None, "", "A", "RC", "C"):
        return 400, {"ok": False, "output": "bad verdict"}
    if action == "post" and payload.get("optimized"):
        payload = dict(payload)
        payload["full"] = False
    try:
        argv = [PRCTL] + ACTIONS[action](payload)
    except (KeyError, ValueError) as e:
        return 400, {"ok": False, "output": f"bad payload: {e}"}
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=180, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return 504, {"ok": False, "output": "prctl timed out"}
    return (200 if p.returncode == 0 else 500), {"ok": p.returncode == 0, "output": (p.stdout + p.stderr).strip()[-4000:]}


