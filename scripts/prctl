#!/usr/bin/env bash
# PR cockpit CLI: every open PR of the org with my review state, staged reviewer-ultra reports, session claims.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/pr-lib.sh"

usage() {
  cat <<'EOF'
usage: prctl <command> [args]
  board [--repo X] [--all] [--fresh] [--json]      what needs you · waiting on author · approved · mine
  show <ref>                                       one PR: fields, my reviews, claims
  sync [--repo X]                                  pull from GitHub now
  review <ref> [--now]                             queue a reviewer-ultra run for the worker, or run it here
  staged | read <ref> | edit <ref>                 staged reports
  post <ref> [--verdict A|RC|C] [--full] [--yes] [--force]
  discard <ref> [--reason T]
  skip <ref> [--days N] [--reason T] | unskip <ref>
  claim <ref> [--note T] | release [<ref>|--all] | sessions [--all|--prune] | whoami | label <text>
      (session = $CLAUDE_CODE_SESSION_ID, or --session <id>)
  worker start [--sync-only|--queue-only] | stop | status
  watch [--once] [--interval N]                    live dashboard: worker, current review + last action, queue, staged, recent
  log <ref>                                        readable live tail of a running/finished review session
  history [--days N]                               review runs and outcomes (default 2 days)
  config list | get <key> | set <key> <value>      keys: model (claude-sonnet-5|claude-opus-4-8) max_diff stale_author_days stale_days ignore_repos ignore_authors
ref = repo#N | Org/repo#N | N (when cwd is inside that repo)
EOF
}

cmd="${1:-board}"; [[ $# -gt 0 ]] && shift
[[ "$cmd" == "-h" || "$cmd" == "--help" || "$cmd" == "help" ]] && { usage; exit 0; }
require_db

# ---------------------------------------------------------------- shared
maybe_sync() {  # 1 = force
  local last age
  last="$(setting_get last_sync_at)"
  if [[ "$1" == 1 || -z "$last" ]]; then
    "$ROOT/scripts/pr-sync" >/dev/null || echo "warn: sync had failures" >&2
    return 0
  fi
  age="$(sql_ro "SELECT CAST((julianday('now') - julianday('$last')) * 1440 AS INTEGER);")"
  if (( age >= 10 )); then "$ROOT/scripts/pr-sync" >/dev/null || echo "warn: sync had failures" >&2; fi
  return 0
}
latest_review_id() {  # pr_id, status list e.g. "'staged','posted'"
  sql_ro "SELECT id FROM pr_reviews WHERE pr_id = $1 AND status IN ($2) ORDER BY id DESC LIMIT 1;"
}
review_field() { sql_ro "SELECT $2 FROM pr_reviews WHERE id = $1;"; }

# ---------------------------------------------------------------- board
row_status_text() {  # status verdict behind ready waiting decision
  case "$1" in
    staged)         printf 'staged %s%s' "${2:-?}" "$([[ "$3" == 1 ]] && printf ' (behind)')" ;;
    waiting-author) printf 'waiting %sd' "$5" ;;
    approved)       if [[ "$4" == 1 ]]; then printf 'ready ✓'; else printf 'approved'; fi ;;
    mine)           if [[ "$4" == 1 ]]; then printf 'ready ✓'; else printf '%s' "$(lower "${6:-no-review}")"; fi ;;
    *)              printf '%s' "$1" ;;
  esac
}
row_flags() {  # stale conflicts ci_red checks status claims too_big
  local f=""
  [[ "$1" == 1 ]] && f+="STALE "
  [[ "$2" == 1 ]] && f+="conflicts "
  [[ "$3" == 1 ]] && f+="ci-red "
  [[ "$4" == SUCCESS && ( "$5" == approved || "$5" == mine ) ]] && f+="green "
  [[ "$7" == 1 ]] && f+="too-big "
  [[ -n "$6" ]] && f+="s:$6 "
  printf '%s' "${f% }"
}
section() {  # title, status filter SQL, extra where
  local rows cols title_w
  rows="$(sqlite3 -cmd '.timeout 5000' -readonly -separator $'\x1f' "$DB" "
    SELECT repo, number, status, COALESCE(active_review_verdict, ''), COALESCE(active_review_behind, 0), stale, ready,
           conflicts, ci_red, too_big, COALESCE(age_days, 0), COALESCE(waiting_days, 0), COALESCE(author, ''), COALESCE(claims, ''),
           COALESCE(checks, ''), COALESCE(review_decision, ''), COALESCE(title, '')
    FROM pr_board WHERE ($3) AND ($2)
    ORDER BY stale DESC, age_days DESC, repo, number;")"
  [[ -n "$rows" ]] || return 0
  cols="$(tput cols 2>/dev/null || echo 120)"; title_w=$(( cols - 90 )); (( title_w < 20 )) && title_w=20
  echo "$1"
  while IFS=$'\x1f' read -r repo num status verdict behind stale ready conflicts ci_red too_big age waiting author claims checks decision title; do
    printf '  %-28s %-20s %4s  %-12s %-20s %s\n' \
      "$(pr_ref_short "$repo" "$num")" \
      "$(row_status_text "$status" "$verdict" "$behind" "$ready" "$waiting" "$decision")" \
      "${age}d" "${author:0:12}" \
      "$(row_flags "$stale" "$conflicts" "$ci_red" "$checks" "$status" "$claims" "$too_big" | cut -c1-20)" \
      "${title:0:$title_w}"
  done <<< "$rows"
}
cmd_board() {
  local repo_filter="" show_all=0 fresh=0 as_json=0 where="1=1" last age
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo_filter="$2"; shift 2 ;; --all) show_all=1; shift ;; --fresh) fresh=1; shift ;; --json) as_json=1; shift ;;
      *) echo "unknown option $1" >&2; exit 1 ;;
    esac
  done
  maybe_sync "$fresh"
  [[ -n "$repo_filter" ]] && where="repo LIKE '%/$(sql_esc "$repo_filter")' COLLATE NOCASE"
  if [[ "$as_json" == 1 ]]; then
    sqlite3 -cmd '.timeout 5000' -readonly -json "$DB" "SELECT * FROM pr_board WHERE $where ORDER BY repo, number;"; return 0
  fi
  last="$(setting_get last_sync_at)"; age="?"
  [[ -n "$last" ]] && age="$(sql_ro "SELECT CAST((julianday('now') - julianday('$last')) * 1440 AS INTEGER);")"
  echo "$PR_ORG PRs · synced ${age}m ago · worker: $(worker_state_text)"
  section "NEEDS YOU"         "status IN ('running','staged','review-failed','re-review','author-replied','needs-review')" "$where"
  section "WAITING ON AUTHOR" "status IN ('waiting-author','commented')" "$where"
  section "APPROVED"          "status = 'approved'" "$where"
  section "MINE"              "status = 'mine'" "$where"
  if [[ "$show_all" == 1 ]]; then section "SKIPPED" "status = 'skipped'" "$where"; section "DRAFTS" "status = 'draft'" "$where"; fi
  sqlite3 -cmd '.timeout 5000' -readonly -separator '|' "$DB" "SELECT
      (SELECT COUNT(*) FROM pr_board WHERE ($where) AND status = 'skipped'),
      (SELECT COUNT(*) FROM pr_board WHERE ($where) AND status = 'draft'),
      (SELECT COUNT(*) FROM pr_board WHERE ($where) AND status = 'needs-review' AND too_big = 0),
      (SELECT COUNT(*) FROM pr_board WHERE ($where) AND status = 're-review' AND too_big = 0),
      (SELECT COUNT(*) FROM pr_board WHERE ($where) AND status IN ('needs-review','re-review') AND too_big = 1);" \
  | { IFS='|' read -r sk dr nr rr tb; echo "skipped $sk · drafts $dr · queue: $nr needs-review, $rr re-review · too-big (manual only): $tb"; }
}

# ---------------------------------------------------------------- show
cmd_show() {
  local id; id="$(pr_id_or_die "$1")"
  if [[ -n "$(sql_ro "SELECT 1 FROM pr_board WHERE id = $id;")" ]]; then
    sqlite3 -cmd '.timeout 5000' -readonly -line "$DB" "SELECT repo || '#' || number AS ref, title, author, status, stale, ready, conflicts, ci_red, too_big, url,
        head_sha, base_ref, mergeable, checks, review_decision, additions, deletions, changed_files,
        my_review_state, my_review_sha, my_review_at, last_commit_at, last_comment_at, skip_until, skip_reason, claims, synced_at FROM pr_board WHERE id = $id;"
  else
    sqlite3 -cmd '.timeout 5000' -readonly -line "$DB" "SELECT repo || '#' || number AS ref, title, author, state, url, head_sha, my_review_state, my_review_sha, my_review_at, synced_at FROM prs WHERE id = $id;"
  fi
  echo; echo "reviews:"
  sql_table "SELECT id, status, verdict, substr(head_sha, 1, 7) AS sha, attempts, queued_at, finished_at, posted_at, error FROM pr_reviews WHERE pr_id = $id ORDER BY id DESC;"
  echo; echo "claims:"
  sql_table "SELECT COALESCE(s.label, substr(s.id, 1, 8)) AS session, s.kind, s.repo, c.note, c.claimed_at
             FROM pr_claims c JOIN sessions s ON s.id = c.session_id WHERE c.pr_id = $id AND c.released_at IS NULL;"
}

# ---------------------------------------------------------------- reviews
cmd_review() {
  local id now=0 sha rid
  id="$(pr_id_or_die "$1")"; shift
  [[ "${1:-}" == "--now" ]] && now=1
  if [[ -n "$(latest_review_id "$id" "'queued','running'")" ]]; then
    echo "$(pr_ref_of_id "$id") already has a queued/running review (prctl show)" >&2; exit 1
  fi
  sha="$(sql_ro "SELECT head_sha FROM prs WHERE id = $id;")"
  rid="$(sql "INSERT INTO pr_reviews (pr_id, head_sha, status) VALUES ($id, $(sql_str "$sha"), 'queued'); SELECT last_insert_rowid();")"
  if [[ "$now" == 1 ]]; then exec "$ROOT/scripts/pr-review-run" "$id" --review-id "$rid"; fi
  echo "queued review $rid for $(pr_ref_of_id "$id") — the worker picks it next (prctl worker status)"
}
cmd_staged() {
  sql_table "SELECT r.id, substr(p.repo, instr(p.repo, '/') + 1) || '#' || p.number AS ref, COALESCE(r.verdict, '?') AS verdict,
                    CASE WHEN r.head_sha <> p.head_sha THEN 'behind' ELSE 'at-head' END AS sha,
                    CAST((julianday('now') - julianday(r.finished_at)) * 24 AS INTEGER) || 'h' AS age, r.report_path
             FROM pr_reviews r JOIN prs p ON p.id = r.pr_id WHERE r.status = 'staged' ORDER BY r.finished_at;"
}
cmd_read() {
  local id rid path
  id="$(pr_id_or_die "$1")"
  rid="$(latest_review_id "$id" "'staged'")"; [[ -n "$rid" ]] || rid="$(latest_review_id "$id" "'posted','discarded'")"
  path="$( [[ -n "$rid" ]] && review_field "$rid" report_path || true )"
  [[ -n "$path" && -f "$path" ]] || { echo "no report for $(pr_ref_of_id "$id")" >&2; exit 1; }
  cat "$path"
}
cmd_edit() {
  local id rid path
  id="$(pr_id_or_die "$1")"
  rid="$(latest_review_id "$id" "'staged'")"
  path="$( [[ -n "$rid" ]] && review_field "$rid" report_path || true )"
  [[ -n "$path" && -f "$path" ]] || { echo "nothing staged for $(pr_ref_of_id "$id")" >&2; exit 1; }
  "${EDITOR:-vi}" "$path"
}
cmd_discard() {
  local id rid reason=""
  id="$(pr_id_or_die "$1")"; shift
  [[ "${1:-}" == "--reason" ]] && reason="${2:-}"
  rid="$(latest_review_id "$id" "'staged','queued'")"
  if [[ -z "$rid" ]]; then
    [[ -n "$(latest_review_id "$id" "'running'")" ]] && { echo "review is running — prctl worker stop, or wait" >&2; exit 1; }
    echo "nothing staged or queued for $(pr_ref_of_id "$id")" >&2; exit 1
  fi
  sql "UPDATE pr_reviews SET status = 'discarded', error = $(sql_str "${reason:-discarded}"), finished_at = COALESCE(finished_at, CURRENT_TIMESTAMP) WHERE id = $rid;"
  echo "discarded review $rid for $(pr_ref_of_id "$id")"
}

# ---------------------------------------------------------------- skip / config
cmd_skip() {
  local id days="" reason="" until="'9999-12-31 00:00:00'"
  id="$(pr_id_or_die "$1")"; shift
  while [[ $# -gt 0 ]]; do case "$1" in --days) days="$2"; shift 2 ;; --reason) reason="$2"; shift 2 ;; *) echo "unknown option $1" >&2; exit 1 ;; esac; done
  [[ -n "$days" ]] && until="datetime('now', '+$days days')"
  sql "UPDATE prs SET skip_until = $until, skip_reason = $(sql_str "$reason") WHERE id = $id;"
  echo "skipped $(pr_ref_of_id "$id")${days:+ for $days days}"
}
cmd_unskip() {
  local id; id="$(pr_id_or_die "$1")"
  sql "UPDATE prs SET skip_until = NULL, skip_reason = NULL WHERE id = $id;"
  echo "unskipped $(pr_ref_of_id "$id")"
}
cmd_config() {
  local int_keys=" max_diff stale_author_days stale_days " str_keys=" ignore_repos ignore_authors model "
  case "${1:-list}" in
    list) sql_table "SELECT key, value, updated_at FROM pr_settings ORDER BY key;" ;;
    get)  setting_get "$2"; echo ;;
    set)  if [[ "$int_keys" == *" $2 "* ]]; then
            [[ "$3" =~ ^[0-9]+$ ]] || { echo "value must be an integer" >&2; exit 1; }
          elif [[ "$2" == model ]]; then
            [[ "$3" == claude-sonnet-5 || "$3" == claude-opus-4-8 ]] || { echo "model must be claude-sonnet-5 or claude-opus-4-8" >&2; exit 1; }
          elif [[ "$str_keys" != *" $2 "* ]]; then
            echo "unknown key $2 — one of:$int_keys$str_keys" >&2; exit 1
          fi
          setting_set "$2" "$3"; echo "$2 = $3" ;;
    *) usage; exit 1 ;;
  esac
}

# ---------------------------------------------------------------- post
strip_transparency() {  # stdin report → stdout without the two transparency sections
  awk '
    /^### False Positives Removed/ || /^### Dropped as defensive/ { skipping = 1; next }
    skipping && (/^## / || /^### / || /^---/ || /\*\*Verdict:\*\*/) { skipping = 0 }
    !skipping { print }
  '
}
cmd_post() {
  local ref="$1" id rid override="" full=0 yes=0 force=0 repo num head state author verdict rsha path event dbstate ghid tmp me
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verdict) override="$2"; shift 2 ;; --full) full=1; shift ;; --yes|-y) yes=1; shift ;; --force) force=1; shift ;;
      *) echo "unknown option $1" >&2; exit 1 ;;
    esac
  done
  id="$(pr_id_or_die "$ref")"
  rid="$(latest_review_id "$id" "'staged'")"
  if [[ -z "$rid" ]]; then
    if [[ "$force" == 1 ]]; then rid="$(latest_review_id "$id" "'posted'")"; fi
    if [[ -z "$rid" ]]; then
      if [[ -n "$(latest_review_id "$id" "'posted'")" ]]; then echo "already posted for $(pr_ref_of_id "$id") — --force posts a new review" >&2
      else echo "nothing staged for $(pr_ref_of_id "$id") — run prctl review $ref" >&2; fi
      exit 1
    fi
  fi
  "$ROOT/scripts/pr-sync" --pr "$ref" >/dev/null 2>&1 || echo "warn: could not refresh $(pr_ref_of_id "$id") from GitHub" >&2
  IFS='|' read -r repo num head state author < <(sql_ro "SELECT repo, number, head_sha, state, author FROM prs WHERE id = $id;")
  [[ "$state" == open ]] || { echo "PR is $state — not posting" >&2; exit 1; }
  IFS='|' read -r verdict rsha path < <(sql_ro "SELECT COALESCE(verdict, ''), head_sha, report_path FROM pr_reviews WHERE id = $rid;")
  [[ -n "$path" && -f "$path" ]] || { echo "report file missing: $path" >&2; exit 1; }
  me="$(gh_me)"

  case "${override:-$verdict}" in
    A|APPROVE|APPROVE_WITH_COMMENTS) event=approve ;;
    RC|REQUEST_CHANGES|BLOCK)        event=request-changes ;;
    C|COMMENT)                       event=comment ;;
    "")                              event=comment; echo "warn: verdict unparsed — posting as a comment (use --verdict)" >&2 ;;
    *) echo "bad --verdict '$override' (A|RC|C)" >&2; exit 1 ;;
  esac
  if [[ "$author" == "$me" && "$event" != comment ]]; then echo "own PR — GitHub forbids self-review, posting as a comment" >&2; event=comment; fi
  case "$event" in approve) dbstate=APPROVED ;; request-changes) dbstate=CHANGES_REQUESTED ;; comment) dbstate=COMMENTED ;; esac

  tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
  if [[ "$full" == 1 ]]; then cp "$path" "$tmp"; else strip_transparency < "$path" > "$tmp"; fi
  [[ -s "$tmp" ]] || { echo "empty body after stripping — use --full or prctl edit" >&2; exit 1; }

  echo "post → $(pr_ref_short "$repo" "$num") · $event · $(wc -l < "$tmp" | tr -d ' ') lines"
  if [[ "$rsha" != "$head" ]]; then echo "warn: reviewed ${rsha:0:7}, head is ${head:0:7} — the review may be stale"; fi
  if [[ "$yes" != 1 ]]; then
    head -n 15 "$tmp" | sed 's/^/  | /'
    read -r -p "Post this $event review? [y/N] " ans
    [[ "$ans" == y || "$ans" == Y ]] || { echo "aborted"; exit 1; }
  fi
  gh pr review "$num" --repo "$repo" "--$event" --body-file "$tmp" || { echo "gh pr review failed — nothing recorded" >&2; exit 1; }
  ghid="$(gh api "repos/$repo/pulls/$num/reviews" --jq "[.[] | select(.user.login == \"$me\")] | last | .id // empty" 2>/dev/null || true)"
  [[ "$ghid" =~ ^[0-9]+$ ]] || ghid=NULL
  sql "UPDATE pr_reviews SET status = 'posted', posted_at = CURRENT_TIMESTAMP, gh_review_id = $ghid WHERE id = $rid;
       UPDATE prs SET my_review_state = '$dbstate', my_review_sha = $(sql_str "$head"), my_review_at = CURRENT_TIMESTAMP WHERE id = $id;"
  echo "posted $event review on $(pr_ref_short "$repo" "$num") (gh review ${ghid})"
}

# ---------------------------------------------------------------- sessions
session_override=""; REST=()
take_session_opt() {  # strips --session <id> from "$@" into session_override; the rest lands in REST
  REST=()
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--session" ]]; then session_override="${2:-}"; shift 2; else REST+=("$1"); shift; fi
  done
}
current_session() {
  local s="${session_override:-${CLAUDE_CODE_SESSION_ID:-}}"
  [[ -n "$s" ]] || { echo "not inside a Claude session — pass --session <id> (see prctl sessions)" >&2; exit 1; }
  printf '%s' "$s"
}
ensure_session_row() {
  local repo; repo="$(repo_from_cwd 2>/dev/null || true)"
  sql "INSERT INTO sessions (id, cwd, repo, last_seen_at) VALUES ($(sql_str "$1"), $(sql_str "$PWD"), $(sql_str "$repo"), CURRENT_TIMESTAMP)
       ON CONFLICT(id) DO UPDATE SET last_seen_at = CURRENT_TIMESTAMP, ended_at = NULL;"
}
cmd_claim() {
  local ref note="" id sid
  take_session_opt "$@"; set -- ${REST[@]+"${REST[@]}"}
  ref="${1:?ref required}"; shift
  [[ "${1:-}" == "--note" ]] && note="${2:-}"
  id="$(pr_id_or_die "$ref")"; sid="$(current_session)"; ensure_session_row "$sid"
  sql "INSERT INTO pr_claims (pr_id, session_id, note)
       SELECT $id, $(sql_str "$sid"), $(sql_str "$note")
       WHERE NOT EXISTS (SELECT 1 FROM pr_claims WHERE pr_id = $id AND session_id = $(sql_str "$sid") AND released_at IS NULL);
       UPDATE sessions SET label = COALESCE(label, $(sql_str "$(pr_ref_of_id "$id")")) WHERE id = $(sql_str "$sid");"
  echo "claimed $(pr_ref_of_id "$id") for session ${sid:0:8}"
}
cmd_release() {
  local sid id
  take_session_opt "$@"; set -- ${REST[@]+"${REST[@]}"}
  sid="$(current_session)"
  if [[ "${1:-}" == "--all" || -z "${1:-}" ]]; then
    sql "UPDATE pr_claims SET released_at = CURRENT_TIMESTAMP WHERE session_id = $(sql_str "$sid") AND released_at IS NULL;"
    echo "released all claims of session ${sid:0:8}"
  else
    id="$(pr_id_or_die "$1")"
    sql "UPDATE pr_claims SET released_at = CURRENT_TIMESTAMP WHERE session_id = $(sql_str "$sid") AND pr_id = $id AND released_at IS NULL;"
    echo "released $(pr_ref_of_id "$id")"
  fi
}
cmd_whoami() {
  local sid
  take_session_opt "$@"
  sid="$(current_session)"
  sql_ro "SELECT 'this session = s:' || COALESCE(label, substr(id, 1, 4)) || ' · id ' || substr(id, 1, 8) || ' · ' || COALESCE(repo, 'no repo') || ' · claims: ' ||
                 COALESCE((SELECT group_concat(substr(p.repo, instr(p.repo, '/') + 1) || '#' || p.number, ', ') FROM pr_claims c JOIN prs p ON p.id = c.pr_id
                           WHERE c.session_id = sessions.id AND c.released_at IS NULL), 'none')
          FROM sessions WHERE id = $(sql_str "$sid");" | grep . || echo "this session = ${sid:0:8} (not registered yet — run any prctl claim, or install the hooks)"
}
cmd_label() {
  local sid
  take_session_opt "$@"; set -- ${REST[@]+"${REST[@]}"}
  sid="$(current_session)"; ensure_session_row "$sid"
  sql "UPDATE sessions SET label = $(sql_str "${1:?label text required}") WHERE id = $(sql_str "$sid");"
  echo "session ${sid:0:8} labelled '$1'"
}
cmd_sessions() {
  case "${1:-}" in
    --prune)
      sql "DELETE FROM pr_claims WHERE session_id IN (SELECT id FROM sessions WHERE COALESCE(ended_at, last_seen_at) < datetime('now', '-30 days'));
           DELETE FROM sessions WHERE COALESCE(ended_at, last_seen_at) < datetime('now', '-30 days');"
      echo "pruned sessions older than 30 days" ;;
    --all)
      sql_table "SELECT substr(id, 1, 8) AS id, COALESCE(label, '') AS label, kind, COALESCE(repo, '') AS repo, COALESCE(cwd, '') AS cwd, last_seen_at, COALESCE(ended_at, '') AS ended_at,
                        (SELECT COUNT(*) FROM pr_claims c WHERE c.session_id = sessions.id AND c.released_at IS NULL) AS claims
                 FROM sessions ORDER BY last_seen_at DESC;" ;;
    *)
      sql_table "SELECT substr(id, 1, 8) AS id, COALESCE(label, '') AS label, kind, COALESCE(repo, '') AS repo, COALESCE(cwd, '') AS cwd, last_seen_at,
                        COALESCE((SELECT group_concat(substr(p.repo, instr(p.repo, '/') + 1) || '#' || p.number, ',') FROM pr_claims c JOIN prs p ON p.id = c.pr_id
                                  WHERE c.session_id = sessions.id AND c.released_at IS NULL), '') AS claims
                 FROM sessions WHERE ended_at IS NULL AND last_seen_at > datetime('now', '-48 hours') ORDER BY last_seen_at DESC;" ;;
  esac
}

# ---------------------------------------------------------------- watch / log / history
stream_activity() {  # stream-json log → last human-readable action
  tail -n 60 "$1" 2>/dev/null | jq -r '
    select(.type == "assistant") | .message.content[]?
    | if .type == "tool_use" then
        "→ " + .name + ": " + ((.input.description // .input.skill // .input.command // .input.prompt // .input.file_path // "") | tostring | gsub("\n"; " ") | .[0:90])
      elif .type == "text" and (.text | length) > 0 then "… " + (.text | gsub("\n"; " ") | .[0:90])
      else empty end' 2>/dev/null | tail -1
}
stream_agents() { grep -c '"name":"Agent"' "$1" 2>/dev/null || true; }
render_watch() {
  echo "$PR_ORG PR cockpit · $(date '+%H:%M:%S') · synced $(sql_ro "SELECT CAST((julianday('now') - julianday(COALESCE((SELECT value FROM pr_settings WHERE key='last_sync_at'), '2000-01-01'))) * 1440 AS INTEGER);")m ago · worker: $(worker_state_text)"
  echo
  local rid ref model started hb log elapsed
  IFS='|' read -r rid ref started hb log < <(sql_ro "SELECT r.id, substr(p.repo, instr(p.repo,'/')+1)||'#'||p.number, r.started_at, r.heartbeat_at, COALESCE(r.log_path,'')
                                              FROM pr_reviews r JOIN prs p ON p.id=r.pr_id WHERE r.status='running' ORDER BY r.started_at LIMIT 1;") || true
  if [[ -n "${rid:-}" ]]; then
    elapsed="$(sql_ro "SELECT CAST((julianday('now') - julianday('$started')) * 1440 AS INTEGER);")"
    echo "RUNNING  $ref · ${elapsed}m · review $rid · agents spawned: $(stream_agents "$log") · last heartbeat $(sql_ro "SELECT CAST((julianday('now') - julianday('$hb')) * 86400 AS INTEGER);")s ago"
    echo "         $(stream_activity "$log")"
  else
    echo "RUNNING  —"
  fi
  echo
  echo "QUEUE"
  sql_ro "SELECT '  ' || substr(p.repo, instr(p.repo,'/')+1)||'#'||p.number || '  (queued ' || CAST((julianday('now') - julianday(r.queued_at)) * 1440 AS INTEGER) || 'm ago' || CASE WHEN r.attempts > 0 THEN ', attempt ' || (r.attempts+1) ELSE '' END || ')'
          FROM pr_reviews r JOIN prs p ON p.id=r.pr_id WHERE r.status='queued' ORDER BY r.queued_at, r.id;" | grep . || echo "  (empty)"
  echo
  echo "STAGED — read/post"
  sql_ro "SELECT '  ' || substr(p.repo, instr(p.repo,'/')+1)||'#'||p.number || '  ' || COALESCE(r.verdict,'?') || CASE WHEN r.head_sha<>p.head_sha THEN ' (behind)' ELSE '' END || '  ' || CAST((julianday('now') - julianday(r.finished_at)) * 24 AS INTEGER) || 'h ago  ' || COALESCE(p.title,'')
          FROM pr_reviews r JOIN prs p ON p.id=r.pr_id WHERE r.status='staged' ORDER BY r.finished_at DESC;" | cut -c1-140 | grep . || echo "  (none)"
  echo
  echo "LAST 24H"
  sql_ro "SELECT '  ' || substr(COALESCE(r.finished_at, r.started_at),12,5) || '  ' || substr(p.repo, instr(p.repo,'/')+1)||'#'||p.number || '  ' || r.status || COALESCE(' ' || r.verdict, '') || COALESCE(' — ' || substr(r.error,1,60), '')
          FROM pr_reviews r JOIN prs p ON p.id=r.pr_id WHERE r.status IN ('staged','posted','failed','discarded') AND COALESCE(r.finished_at, r.started_at) > datetime('now','-1 day')
          ORDER BY COALESCE(r.finished_at, r.started_at) DESC LIMIT 12;" | grep . || echo "  (nothing yet)"
}
cmd_watch() {
  local once=0 interval=15
  while [[ $# -gt 0 ]]; do case "$1" in --once) once=1; shift ;; --interval) interval="$2"; shift 2 ;; *) echo "unknown option $1" >&2; exit 1 ;; esac; done
  if [[ "$once" == 1 ]]; then render_watch; return 0; fi
  while true; do printf '\033[H\033[2J'; render_watch; echo; echo "(refresh ${interval}s · Ctrl-C to quit · prctl read <ref> / prctl post <ref>)"; sleep "$interval"; done
}
cmd_log() {  # follows while the review is running; plain dump once it has finished
  local id log status follow=()
  id="$(pr_id_or_die "$1")"
  IFS='|' read -r log status < <(sql_ro "SELECT log_path, status FROM pr_reviews WHERE pr_id = $id AND log_path IS NOT NULL ORDER BY CASE status WHEN 'running' THEN 0 ELSE 1 END, id DESC LIMIT 1;") || true
  [[ -n "${log:-}" && -f "$log" ]] || { echo "no review log for $(pr_ref_of_id "$id")" >&2; exit 1; }
  [[ "$status" == running ]] && follow=(-f)
  echo "== $log ($status) =="
  tail -n +1 ${follow[@]+"${follow[@]}"} "$log" | jq --unbuffered -r '
    if .type == "system" and .subtype == "init" then "[init] model " + (.model // "?") + " session " + (.session_id // "?")
    elif .type == "assistant" then (.message.content[]? | if .type == "tool_use" then "→ " + .name + ": " + ((.input.description // .input.skill // .input.command // .input.prompt // .input.file_path // "") | tostring | gsub("\n"; " ") | .[0:160]) elif .type == "text" then "… " + (.text | gsub("\n"; " ") | .[0:200]) else empty end)
    elif .type == "result" then "[result] " + (.subtype // "") + " · " + ((.result // "") | tostring | .[0:200])
    else empty end' 2>/dev/null
}
cmd_history() {
  local days=2
  [[ "${1:-}" == "--days" ]] && days="${2:-2}"
  sql_table "SELECT r.id, substr(p.repo, instr(p.repo,'/')+1)||'#'||p.number AS ref, r.status, COALESCE(r.verdict,'') AS verdict, r.attempts,
                    substr(COALESCE(r.started_at, r.queued_at),6,11) AS started, substr(COALESCE(r.finished_at,''),12,5) AS finished,
                    CASE WHEN r.started_at IS NOT NULL AND r.finished_at IS NOT NULL THEN CAST((julianday(r.finished_at)-julianday(r.started_at))*1440 AS INTEGER)||'m' ELSE '' END AS took,
                    COALESCE(substr(r.error,1,50),'') AS error
             FROM pr_reviews r JOIN prs p ON p.id=r.pr_id WHERE COALESCE(r.finished_at, r.started_at, r.queued_at) > datetime('now', '-$days days')
             ORDER BY r.id DESC;"
}

# ---------------------------------------------------------------- dispatch
case "$cmd" in
  board)   cmd_board "$@" ;;
  show)    cmd_show "${1:?ref required}" ;;
  sync)    "$ROOT/scripts/pr-sync" "$@" ;;
  review)  cmd_review "${1:?ref required}" "${@:2}" ;;
  staged)  cmd_staged ;;
  read)    cmd_read "${1:?ref required}" ;;
  edit)    cmd_edit "${1:?ref required}" ;;
  discard) cmd_discard "${1:?ref required}" "${@:2}" ;;
  skip)    cmd_skip "${1:?ref required}" "${@:2}" ;;
  unskip)  cmd_unskip "${1:?ref required}" ;;
  config)  cmd_config "$@" ;;
  post)    cmd_post "${1:?ref required}" "${@:2}" ;;
  claim)   cmd_claim "$@" ;;
  release) cmd_release "$@" ;;
  sessions) cmd_sessions "$@" ;;
  whoami)  cmd_whoami "$@" ;;
  label)   cmd_label "$@" ;;
  worker)  exec "$ROOT/scripts/pr-worker" "$@" ;;
  watch)   cmd_watch "$@" ;;
  log)     cmd_log "${1:?ref required}" ;;
  history) cmd_history "$@" ;;
  *) usage; exit 1 ;;
esac
