#!/usr/bin/env bash
# Integration tests for the PR cockpit (migrate-v5, pr-sync, pr_board view, prctl, pr-review-run, pr-worker, hooks).
# Runs offline: fake `gh` and `claude` shims on PATH, throwaway DB via TASK_DB_PATH.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
export TASK_DB_PATH="$TMP/test.db" CTF_GH_ME=testme CTF_PR_NOTIFY=0 CTF_PR_ORG=FS-Code \
       CTF_PR_REVIEWS_DIR="$TMP/reviews" CTF_TMUX_SESSION="ctf-test-none-$$" FAKE_DIR="$TMP/fake"
mkdir -p "$FAKE_DIR/bin" "$FAKE_DIR/gh"
export PATH="$FAKE_DIR/bin:$PATH"
unset CLAUDE_CODE_SESSION_ID

fail=0
ok()  { printf "  [ok] %s\n" "$1"; }
bad() { printf "  [FAIL] %s\n" "$1"; fail=1; }
chk() { if eval "$2"; then ok "$1"; else bad "$1"; fi; }
has() { grep -c -- "$@" >/dev/null; }   # grep -q would SIGPIPE the producer and trip pipefail
db()  { sqlite3 "$TASK_DB_PATH" "$1"; }
reset_db() {
  rm -f "$TASK_DB_PATH"
  sqlite3 "$TASK_DB_PATH" "CREATE TABLE projects (id INTEGER PRIMARY KEY, name TEXT, github_repo TEXT, local_path TEXT);"
  "$ROOT/scripts/migrate-v5-prs.sh" >/dev/null
}

# ===================================================================== 1. schema
echo "== schema =="
reset_db
for t in prs pr_reviews sessions pr_claims pr_settings; do
  chk "table $t exists" "db 'SELECT 1 FROM $t LIMIT 0;'"
done
chk "view pr_board exists" "db 'SELECT 1 FROM pr_board LIMIT 0;'"
chk "settings seeded" "[[ \$(db \"SELECT value FROM pr_settings WHERE key='max_diff';\") == 3000 ]]"
"$ROOT/scripts/migrate-v5-prs.sh" >/dev/null
chk "migration is idempotent" "db 'SELECT 1 FROM pr_board LIMIT 0;'"
chk "prs unique (repo,number)" "! db \"INSERT INTO prs (repo,number) VALUES ('FS-Code/a',1),('FS-Code/a',1);\" 2>/dev/null"

# ===================================================================== 2. fake gh + fixtures
cat > "$FAKE_DIR/bin/gh" <<'EOF'
#!/usr/bin/env bash
# fake gh: answers from $FAKE_DIR/gh/*.json; records `pr review` calls in calls.log and copies the body to last-body.md
set -e
args=("$@"); jqexpr=""; repo=""; body=""; name=""; number=""
for ((i=0; i<${#args[@]}; i++)); do
  case "${args[$i]}" in
    --jq) jqexpr="${args[$((i+1))]}" ;;
    --repo) repo="${args[$((i+1))]}" ;;
    --body-file) body="${args[$((i+1))]}" ;;
    -F) case "${args[$((i+1))]}" in name=*) name="${args[$((i+1))]#name=}" ;; number=*) number="${args[$((i+1))]#number=}" ;; esac ;;
  esac
done
out() { if [[ -n "$jqexpr" ]]; then jq -r "$jqexpr"; else cat; fi; }
# fixtures are flat (pr-list style); wrap them into the GraphQL node shape pr-sync queries for
TO_NODE='def to_node: . + {
  commits: {nodes: [{commit: {committedDate: ((.commits // []) | map(.committedDate) | max),
                               statusCheckRollup: (if ((.statusCheckRollup // []) | length) > 0 then {contexts: {nodes: .statusCheckRollup}} else null end)}}]},
  reviews: {nodes: (.reviews // [])}, comments: {nodes: (.comments // [])}};'
case "$1 $2" in
  "search prs")  cat "$FAKE_DIR/gh/search.json" | out ;;
  "api graphql")
    if [[ -n "$number" ]]; then
      f="$FAKE_DIR/gh/view-$name-$number.json"; [[ -f "$f" ]] || { echo '{"errors":[{"message":"not found"}]}'; exit 1; }
      jq "$TO_NODE {data:{repository:{pullRequest: (. | to_node)}}}" "$f"
    else
      f="$FAKE_DIR/gh/list-$name.json"; { [[ -f "$f" ]] && cat "$f" || echo '[]'; } | jq "$TO_NODE {data:{repository:{pullRequests:{pageInfo:{hasNextPage:false,endCursor:null}, nodes: map(to_node)}}}}"
    fi ;;
  "pr view")     f="$FAKE_DIR/gh/view-${repo#*/}-$3.json"; [[ -f "$f" ]] || { echo "not found" >&2; exit 1; }; cat "$f" | out ;;
  "pr review")  echo "pr review $*" >> "$FAKE_DIR/gh/calls.log"; [[ -n "$body" ]] && cp "$body" "$FAKE_DIR/gh/last-body.md"; [[ -f "$FAKE_DIR/gh/review-fail" ]] && exit 1; exit 0 ;;
  "api user")   echo '{"login":"testme"}' | out ;;
  "api repos"*) f="$FAKE_DIR/gh/reviews-api.json"; { [[ -f "$f" ]] && cat "$f" || echo '[]'; } | out ;;
  *) echo "fake gh: unhandled: $*" >&2; exit 1 ;;
esac
EOF
chmod +x "$FAKE_DIR/bin/gh"

ago()  { date -u -v-"$1"d '+%Y-%m-%dT%H:%M:%SZ'; }
rev()  { jq -n --arg a "$1" --arg s "$2" --arg h "$3" --arg t "$(ago "$4")" '{author:{login:$a}, state:$s, submittedAt:$t, commit:{oid:$h}}'; }
cmt()  { jq -n --arg a "$1" --arg t "$(ago "$2")" '{author:{login:$a}, createdAt:$t}'; }
mkpr() { # number author headsha created_days_ago [extra jq object expression, e.g. '{isDraft:true}']
  local extra="${5:-}"; [[ -n "$extra" ]] || extra='{}'
  jq -n --argjson n "$1" --arg a "$2" --arg h "$3" --arg c "$(ago "$4")" \
    '{number:$n, title:("PR "+($n|tostring)), author:{login:$a}, url:("https://github.com/FS-Code/x/pull/"+($n|tostring)),
      baseRefName:"main", headRefName:("b"+($n|tostring)), headRefOid:$h, isDraft:false, mergeable:"MERGEABLE", reviewDecision:"",
      additions:10, deletions:2, changedFiles:1, createdAt:$c, updatedAt:$c, statusCheckRollup:[], reviews:[], comments:[],
      commits:[{oid:$h, committedDate:$c}]}' | jq ". + $extra"
}
CR_OK='[{"__typename":"CheckRun","status":"COMPLETED","conclusion":"SUCCESS"}]'
CR_BAD='[{"__typename":"CheckRun","status":"COMPLETED","conclusion":"FAILURE"}]'
CR_PEND='[{"__typename":"CheckRun","status":"IN_PROGRESS","conclusion":null}]'

echo '[{"repository":{"nameWithOwner":"FS-Code/alpha"}},{"repository":{"nameWithOwner":"FS-Code/beta"}}]' > "$FAKE_DIR/gh/search.json"
{
  mkpr 1  dev1 aaa1111 10
  mkpr 2  dev1 bbb2222 9  "{reviews:[$(rev testme CHANGES_REQUESTED bbb0000 4)], commits:[{oid:\"bbb2222\",committedDate:\"$(ago 1)\"}], updatedAt:\"$(ago 1)\"}"
  mkpr 3  dev2 ccc3333 8  "{reviews:[$(rev testme CHANGES_REQUESTED ccc3333 5)], updatedAt:\"$(ago 5)\"}"
  mkpr 4  dev2 ddd4444 6  "{reviews:[$(rev testme CHANGES_REQUESTED ddd4444 2)], comments:[$(cmt dev2 1)], updatedAt:\"$(ago 1)\"}"
  mkpr 5  dev1 eee5555 4  "{reviews:[$(rev testme APPROVED eee5555 1)], statusCheckRollup:$CR_OK, updatedAt:\"$(ago 1)\"}"
  mkpr 6  testme fff6666 1 "{reviewDecision:\"APPROVED\", statusCheckRollup:$CR_OK}"
  mkpr 7  dev1 0007777 1  '{isDraft:true}'
  mkpr 8  'dependabot[bot]' 0008888 1
  mkpr 9  dev2 0009999 1  '{additions:5000, deletions:10}'
  mkpr 10 dev1 0010101 1  "{statusCheckRollup:$CR_BAD}"
  mkpr 11 dev1 0011111 1  '{mergeable:"CONFLICTING"}'
  mkpr 12 dev1 0012121 1  "{statusCheckRollup:$CR_PEND, reviews:[$(rev testme APPROVED 0012121 0)]}"
} | jq -s '.' > "$FAKE_DIR/gh/list-alpha.json"
mkpr 1 dev3 abc0001 3 | jq -s '.' > "$FAKE_DIR/gh/list-beta.json"
echo '{"state":"MERGED"}' > "$FAKE_DIR/gh/view-alpha-99.json"

# ===================================================================== 3. pr-sync + view
echo "== pr-sync =="
reset_db
db "INSERT INTO prs (repo, number, state, head_sha, synced_at) VALUES ('FS-Code/alpha', 99, 'open', 'old', '2020-01-01 00:00:00');
    INSERT INTO pr_reviews (pr_id, head_sha, status) VALUES (1, 'old', 'staged');"
"$ROOT/scripts/pr-sync" >/dev/null; rc=$?
chk "pr-sync exits 0" "[[ $rc -eq 0 ]]"
chk "13 open PRs synced" "[[ \$(db \"SELECT COUNT(*) FROM prs WHERE state='open';\") == 13 ]]"
chk "gh_login cached" "[[ \$(db \"SELECT value FROM pr_settings WHERE key='gh_login';\") == testme ]]"
chk "last_sync_at set" "[[ -n \$(db \"SELECT value FROM pr_settings WHERE key='last_sync_at';\") ]]"
chk "vanished PR marked merged" "[[ \$(db \"SELECT state FROM prs WHERE repo='FS-Code/alpha' AND number=99;\") == merged ]]"
chk "its staged review discarded" "[[ \$(db \"SELECT status FROM pr_reviews WHERE id=1;\") == discarded ]]"
chk "my_review_sha from commit oid" "[[ \$(db \"SELECT my_review_sha FROM prs WHERE repo='FS-Code/alpha' AND number=2;\") == bbb0000 ]]"
chk "datetimes normalized (no T)" "[[ \$(db \"SELECT gh_created_at FROM prs WHERE repo='FS-Code/alpha' AND number=1;\") != *T* ]]"
chk "checks FAILURE rollup" "[[ \$(db \"SELECT checks FROM prs WHERE repo='FS-Code/alpha' AND number=10;\") == FAILURE ]]"
chk "checks PENDING rollup" "[[ \$(db \"SELECT checks FROM prs WHERE repo='FS-Code/alpha' AND number=12;\") == PENDING ]]"
chk "checks NONE when empty" "[[ \$(db \"SELECT checks FROM prs WHERE repo='FS-Code/alpha' AND number=1;\") == NONE ]]"
chk "bot auto-skipped" "[[ \$(db \"SELECT skip_until IS NOT NULL FROM prs WHERE repo='FS-Code/alpha' AND number=8;\") == 1 ]]"
"$ROOT/scripts/pr-sync" >/dev/null
chk "re-sync is idempotent (still 13)" "[[ \$(db \"SELECT COUNT(*) FROM prs WHERE state='open';\") == 13 ]]"
db "UPDATE prs SET skip_until=NULL WHERE repo='FS-Code/alpha' AND number=8;"; "$ROOT/scripts/pr-sync" >/dev/null
chk "unskipped bot stays unskipped" "[[ \$(db \"SELECT skip_until IS NULL FROM prs WHERE repo='FS-Code/alpha' AND number=8;\") == 1 ]]"

echo "== pr_board statuses =="
st() { db "SELECT status FROM pr_board WHERE repo='FS-Code/$1' AND number=$2;"; }
col() { db "SELECT $3 FROM pr_board WHERE repo='FS-Code/$1' AND number=$2;"; }
chk "alpha#1 needs-review"    "[[ \$(st alpha 1) == needs-review ]]"
chk "alpha#1 stale (idle>7d)" "[[ \$(col alpha 1 stale) == 1 ]]"
chk "alpha#2 re-review"       "[[ \$(st alpha 2) == re-review ]]"
chk "alpha#3 waiting-author"  "[[ \$(st alpha 3) == waiting-author ]]"
chk "alpha#3 stale (>3d)"     "[[ \$(col alpha 3 stale) == 1 ]]"
chk "alpha#4 author-replied"  "[[ \$(st alpha 4) == author-replied ]]"
chk "alpha#4 not stale"       "[[ \$(col alpha 4 stale) == 0 ]]"
chk "alpha#5 approved"        "[[ \$(st alpha 5) == approved ]]"
chk "alpha#5 ready"           "[[ \$(col alpha 5 ready) == 1 ]]"
chk "alpha#6 mine"            "[[ \$(st alpha 6) == mine ]]"
chk "alpha#6 ready"           "[[ \$(col alpha 6 ready) == 1 ]]"
chk "alpha#7 draft"           "[[ \$(st alpha 7) == draft ]]"
chk "alpha#8 unskipped bot = needs-review" "[[ \$(st alpha 8) == needs-review ]]"
db "UPDATE prs SET skip_until='9999-12-31 00:00:00' WHERE repo='FS-Code/alpha' AND number=8;"
chk "alpha#8 skipped"         "[[ \$(st alpha 8) == skipped ]]"
chk "alpha#9 too_big"         "[[ \$(col alpha 9 too_big) == 1 ]]"
chk "alpha#10 ci_red"         "[[ \$(col alpha 10 ci_red) == 1 ]]"
chk "alpha#11 conflicts"      "[[ \$(col alpha 11 conflicts) == 1 ]]"
chk "alpha#12 approved not ready" "[[ \$(st alpha 12) == approved && \$(col alpha 12 ready) == 0 ]]"
chk "merged PR not in view"   "[[ -z \$(st alpha 99) ]]"
db "UPDATE pr_settings SET value='100' WHERE key='max_diff';"
chk "config max_diff drives too_big" "[[ \$(col alpha 1 too_big) == 0 && \$(col alpha 9 too_big) == 1 ]]"
db "UPDATE pr_settings SET value='3000' WHERE key='max_diff';"

# ===================================================================== 4. prctl basics
echo "== prctl basics =="
PRCTL="$ROOT/scripts/prctl"
out="$("$PRCTL" board 2>&1)"
chk "board header"            "grep -q 'FS-Code PRs · synced' <<<\"\$out\""
chk "board NEEDS YOU section" "grep -q '^NEEDS YOU' <<<\"\$out\""
chk "board lists alpha#1"     "grep -q 'alpha#1 .*needs-review' <<<\"\$out\""
chk "board STALE flag"        "grep -E 'alpha#3 .*waiting 5d.*STALE' -q <<<\"\$out\""
chk "board ready ✓"           "grep -q 'alpha#5 .*ready ✓' <<<\"\$out\""
chk "board MINE section"      "grep -q '^MINE' <<<\"\$out\" && grep -q 'alpha#6' <<<\"\$out\""
chk "board footer counts"     "grep -q 'skipped 1 · drafts 1' <<<\"\$out\""
chk "board hides drafts"      "! grep -q 'alpha#7' <<<\"\$out\""
chk "board --all shows draft" "\"\$PRCTL\" board --all | has 'alpha#7'"
chk "board --repo filters"    "! \"\$PRCTL\" board --repo beta | has 'alpha#'"
chk "board --json"            "[[ \$(\"\$PRCTL\" board --json | jq 'length') == 13 ]]"
chk "show works"              "\"\$PRCTL\" show alpha#2 | has 're-review'"
chk "bad ref errors"          "! \"\$PRCTL\" show nope 2>/dev/null"
chk "unknown PR errors"       "! \"\$PRCTL\" show alpha#777 2>/dev/null"
"$PRCTL" skip alpha#1 --days 2 --reason "wip" >/dev/null
chk "skip sets skip_until"    "[[ \$(st alpha 1) == skipped ]]"
"$PRCTL" unskip alpha#1 >/dev/null
chk "unskip clears"           "[[ \$(st alpha 1) == needs-review ]]"
chk "config get"              "[[ \$(\"\$PRCTL\" config get max_diff) == 3000 ]]"
"$PRCTL" config set stale_days 30 >/dev/null
chk "config set"              "[[ \$(db \"SELECT value FROM pr_settings WHERE key='stale_days';\") == 30 ]]"
"$PRCTL" config set stale_days 7 >/dev/null
chk "config rejects unknown"  "! \"\$PRCTL\" config set nope 1 2>/dev/null"
"$PRCTL" config set ignore_repos beta >/dev/null
"$ROOT/scripts/pr-sync" >/dev/null
chk "ignore_repos drops repo (beta#1 → closed check)" "[[ \$(db \"SELECT COUNT(*) FROM pr_board WHERE repo='FS-Code/beta';\") == 0 ]]"
"$PRCTL" config set ignore_repos "" >/dev/null; "$ROOT/scripts/pr-sync" >/dev/null
chk "cleared ignore_repos brings beta back" "[[ \$(st beta 1) == needs-review ]]"
"$PRCTL" review alpha#1 >/dev/null
chk "review queues a row"     "[[ \$(db \"SELECT status FROM pr_reviews WHERE pr_id=(SELECT id FROM prs WHERE repo='FS-Code/alpha' AND number=1) ORDER BY id DESC LIMIT 1;\") == queued ]]"
chk "queued shows as running" "[[ \$(st alpha 1) == running ]]"
chk "review twice refuses"    "! \"\$PRCTL\" review alpha#1 2>/dev/null"
"$PRCTL" discard alpha#1 >/dev/null
chk "discard dequeues"        "[[ \$(st alpha 1) == needs-review ]]"
chk "staged empty"            "! \"\$PRCTL\" staged | has 'alpha#'"
chk "read with nothing"       "! \"\$PRCTL\" read alpha#1 2>/dev/null"

# ===================================================================== 5. pr-review-run
echo "== pr-review-run =="
cat > "$FAKE_DIR/bin/claude" <<'EOF'
#!/usr/bin/env bash
# fake `claude -p`: emits stream-json; behaviour via $FAKE_CLAUDE_MODE = report (default) | resultonly | noreport | cap | fail
prompt="${@: -1}"
report="$(printf '%s' "$prompt" | grep -oE '[^ ]+\.md' | head -1)"
echo '{"type":"system","subtype":"init","session_id":"fake-sess-1234","tools":[]}'
echo '{"type":"assistant","message":{"content":[{"type":"text","text":"working on '"$report"'"}]}}'
case "${FAKE_CLAUDE_MODE:-report}" in
  report)     printf '# Review\n\n### Confirmed\n- one real finding\n\n### False Positives Removed\n- fp noise\n\n### Dropped as defensive / not a real problem (Round 3)\n- band-aid\n\n---\n\n**Verdict:** APPROVE_WITH_COMMENTS\n**Summary:** fine\n' > "$report"
              echo '{"type":"result","subtype":"success","result":"REPORT_WRITTEN"}'; exit 0 ;;
  resultonly) echo '{"type":"result","subtype":"success","result":"# Review\n\n**Verdict:** BLOCK\n**Summary:** bad"}'; exit 0 ;;
  noreport)   echo '{"type":"result","subtype":"success","result":"done"}'; exit 0 ;;
  cap)        echo "You've hit your session limit · resets 11:30pm (Asia/Baku)"; exit 1 ;;
  fail)       echo "boom"; exit 2 ;;
esac
EOF
chmod +x "$FAKE_DIR/bin/claude"
RUN="$ROOT/scripts/pr-review-run"
pid_of() { db "SELECT id FROM prs WHERE repo='FS-Code/$1' AND number=$2;"; }
last_review() { db "SELECT $2 FROM pr_reviews WHERE pr_id=$(pid_of alpha $1) ORDER BY id DESC LIMIT 1;"; }

"$RUN" "$(pid_of alpha 1)" >/dev/null 2>&1; rc=$?
chk "run exits 0"                 "[[ $rc -eq 0 ]]"
chk "review staged"               "[[ \$(last_review 1 status) == staged ]]"
chk "verdict parsed"              "[[ \$(last_review 1 verdict) == APPROVE_WITH_COMMENTS ]]"
chk "report file exists"          "test -s \"\$(last_review 1 report_path)\""
chk "log file exists"             "test -s \"\$(last_review 1 log_path)\""
chk "cli_session_id captured"     "[[ \$(last_review 1 cli_session_id) == fake-sess-1234 ]]"
chk "worker session registered"   "[[ \$(db \"SELECT kind FROM sessions WHERE id='fake-sess-1234';\") == worker ]]"
chk "worker claim released"       "[[ \$(db \"SELECT COUNT(*) FROM pr_claims WHERE released_at IS NULL;\") == 0 ]]"
chk "board shows staged"          "[[ \$(st alpha 1) == staged ]]"
chk "prctl staged lists it"       "\"\$PRCTL\" staged | has 'alpha#1'"
chk "prctl read prints report"    "\"\$PRCTL\" read alpha#1 | has 'Verdict'"

FAKE_CLAUDE_MODE=resultonly "$RUN" "$(pid_of alpha 2)" >/dev/null 2>&1
chk "result-only fallback staged" "[[ \$(last_review 2 status) == staged && \$(last_review 2 verdict) == BLOCK ]]"

FAKE_CLAUDE_MODE=noreport "$RUN" "$(pid_of alpha 3)" >/dev/null 2>&1; rc=$?
chk "no report → exit 1"          "[[ $rc -ne 0 ]]"
chk "no report → failed+requeued" "[[ \$(db \"SELECT group_concat(status||':'||attempts) FROM (SELECT status, attempts FROM pr_reviews WHERE pr_id=$(pid_of alpha 3) ORDER BY id);\") == 'failed:1,queued:1' ]]"

FAKE_CLAUDE_MODE=fail "$RUN" "$(pid_of alpha 4)" >/dev/null 2>&1
chk "nonzero exit → failed w/ log tail" "[[ \$(db \"SELECT error FROM pr_reviews WHERE pr_id=$(pid_of alpha 4) AND status='failed';\") == exit\ 2:* ]]"

FAKE_CLAUDE_MODE=cap "$RUN" "$(pid_of alpha 10)" >/dev/null 2>&1
chk "cap → failed:cap, attempts 0"  "[[ \$(db \"SELECT status||':'||error||':'||attempts FROM pr_reviews WHERE pr_id=$(pid_of alpha 10) ORDER BY id LIMIT 1;\") == failed:cap:0 ]]"
chk "cap → requeued"                "[[ \$(last_review 10 status) == queued ]]"
chk "cap → cooldown set in future"  "[[ \$(db \"SELECT datetime('now') < value FROM pr_settings WHERE key='worker_cooldown_until';\") == 1 ]]"
db "DELETE FROM pr_settings WHERE key='worker_cooldown_until';"

"$PRCTL" review alpha#11 --now >/dev/null 2>&1
chk "prctl review --now stages"    "[[ \$(last_review 11 status) == staged ]]"
"$RUN" "$(pid_of alpha 11)" >/dev/null 2>&1
chk "second run same sha → -2 file" "[[ \$(last_review 11 report_path) == *-2.md ]]"

# ===================================================================== 6. pr-worker
echo "== pr-worker =="
WORKER="$ROOT/scripts/pr-worker"
reset_db; "$ROOT/scripts/pr-sync" >/dev/null
export FAKE_CLAUDE_MODE=report
"$WORKER" cycle --inline >/dev/null 2>&1
chk "1st pick = re-review alpha#2"          "[[ \$(st alpha 2) == staged ]]"
"$WORKER" cycle --inline >/dev/null 2>&1
chk "2nd pick = oldest needs-review alpha#1" "[[ \$(st alpha 1) == staged ]]"
"$WORKER" cycle --inline >/dev/null 2>&1
chk "never picks draft/bot/mine/too_big"    "[[ \$(db \"SELECT COUNT(*) FROM pr_board WHERE status='staged' AND number IN (6,7,8,9);\") == 0 ]]"
"$PRCTL" review beta#1 >/dev/null
"$WORKER" cycle --inline >/dev/null 2>&1
chk "explicit queue wins next"              "[[ \$(st beta 1) == staged ]]"
"$WORKER" cycle --sync-only --inline >/dev/null 2>&1
chk "--sync-only never picks"               "[[ \$(db \"SELECT COUNT(*) FROM pr_reviews WHERE status IN ('queued','running');\") == 0 ]]"

db "UPDATE prs SET head_sha='newsha' WHERE repo='FS-Code/alpha' AND number=2;"
chk "staged behind head is not re-picked"   "[[ \$(st alpha 2) == staged && \$(col alpha 2 active_review_behind) == 1 ]]"

export FAKE_CLAUDE_MODE=cap
"$WORKER" cycle --inline >/dev/null 2>&1
chk "cap sets cooldown"                     "[[ -n \$(db \"SELECT value FROM pr_settings WHERE key='worker_cooldown_until';\") ]]"
q_before="$(db "SELECT COUNT(*) FROM pr_reviews WHERE status='queued';")"
out="$("$WORKER" cycle --inline 2>&1)"
chk "cooldown blocks the next pick"         "grep -q cooldown <<<\"\$out\" && [[ \$(db \"SELECT COUNT(*) FROM pr_reviews WHERE status='queued';\") == $q_before ]]"
db "UPDATE pr_settings SET value=datetime('now','-1 minute') WHERE key='worker_cooldown_until';"
export FAKE_CLAUDE_MODE=report
"$WORKER" cycle --inline >/dev/null 2>&1
chk "expired cooldown cleared + queued row ran" "[[ -z \$(db \"SELECT value FROM pr_settings WHERE key='worker_cooldown_until';\") && \$(db \"SELECT COUNT(*) FROM pr_reviews WHERE status='queued';\") == 0 ]]"

db "INSERT INTO pr_reviews (pr_id, head_sha, status, heartbeat_at, started_at, attempts) VALUES ($(pid_of alpha 12), '0012121', 'running', datetime('now','-45 minutes'), datetime('now','-50 minutes'), 0);"
"$WORKER" cycle --sync-only --inline >/dev/null 2>&1
chk "stuck review reaped → failed:stuck"    "[[ \$(db \"SELECT status||':'||error||':'||attempts FROM pr_reviews WHERE pr_id=$(pid_of alpha 12) AND status='failed';\") == failed:stuck:1 ]]"
chk "stuck review requeued once"            "[[ \$(db \"SELECT status||':'||attempts FROM pr_reviews WHERE pr_id=$(pid_of alpha 12) ORDER BY id DESC LIMIT 1;\") == queued:1 ]]"
chk "worker status runs"                    "\"\$WORKER\" status | has 'worker: stopped'"
chk "prctl worker delegates"                "\"\$PRCTL\" worker status | has 'worker: stopped'"
unset FAKE_CLAUDE_MODE

# ===================================================================== 7. prctl post
echo "== prctl post =="
reset_db; "$ROOT/scripts/pr-sync" >/dev/null
view_fixture() { jq ".[] | select(.number==$1) + {state:\"OPEN\"}" "$FAKE_DIR/gh/list-alpha.json" > "$FAKE_DIR/gh/view-alpha-$1.json"; }
for n in 1 2 3 4 5 6; do view_fixture $n; done
echo '[{"id":555,"user":{"login":"testme"},"state":"APPROVED"}]' > "$FAKE_DIR/gh/reviews-api.json"
rm -f "$FAKE_DIR/gh/calls.log" "$FAKE_DIR/gh/last-body.md"
chk "post with nothing staged fails"  "! \"\$PRCTL\" post alpha#1 --yes 2>/dev/null"
FAKE_CLAUDE_MODE=report "$RUN" "$(pid_of alpha 1)" >/dev/null 2>&1
out="$("$PRCTL" post alpha#1 --yes 2>&1)"; rc=$?
chk "post exits 0"                    "[[ $rc -eq 0 ]]"
chk "gh pr review --approve called"   "grep -q -- '--approve' \"\$FAKE_DIR/gh/calls.log\""
chk "transparency sections stripped"  "! grep -q 'False Positives' \"\$FAKE_DIR/gh/last-body.md\" && ! grep -q 'Dropped as defensive' \"\$FAKE_DIR/gh/last-body.md\""
chk "confirmed findings kept"         "grep -q 'one real finding' \"\$FAKE_DIR/gh/last-body.md\" && grep -q 'Verdict' \"\$FAKE_DIR/gh/last-body.md\""
chk "review marked posted w/ gh id"   "[[ \$(db \"SELECT status||':'||gh_review_id FROM pr_reviews WHERE pr_id=$(pid_of alpha 1) ORDER BY id DESC LIMIT 1;\") == posted:555 ]]"
chk "prs.my_review_* updated"         "[[ \$(db \"SELECT my_review_state||':'||my_review_sha FROM prs WHERE id=$(pid_of alpha 1);\") == APPROVED:aaa1111 ]]"
chk "board flips to approved"         "[[ \$(st alpha 1) == approved ]]"
chk "second post refuses"             "! \"\$PRCTL\" post alpha#1 --yes 2>/dev/null"
rm -f "$FAKE_DIR/gh/calls.log"
"$PRCTL" post alpha#1 --yes --force >/dev/null 2>&1
chk "--force reposts"                 "grep -q 'pr review' \"\$FAKE_DIR/gh/calls.log\""

FAKE_CLAUDE_MODE=resultonly "$RUN" "$(pid_of alpha 2)" >/dev/null 2>&1
db "UPDATE prs SET head_sha='moved99' WHERE id=$(pid_of alpha 2);"
jq '.headRefOid="moved99"' "$FAKE_DIR/gh/view-alpha-2.json" > "$FAKE_DIR/gh/tmp.json" && mv "$FAKE_DIR/gh/tmp.json" "$FAKE_DIR/gh/view-alpha-2.json"
rm -f "$FAKE_DIR/gh/calls.log"
out="$("$PRCTL" post alpha#2 --yes 2>&1)"
chk "BLOCK → --request-changes"       "grep -q -- '--request-changes' \"\$FAKE_DIR/gh/calls.log\""
chk "warns when head moved"           "grep -qi 'head is' <<<\"\$out\""
FAKE_CLAUDE_MODE=report "$RUN" "$(pid_of alpha 3)" >/dev/null 2>&1
rm -f "$FAKE_DIR/gh/calls.log"
"$PRCTL" post alpha#3 --yes --verdict C >/dev/null 2>&1
chk "--verdict C → --comment"         "grep -q -- '--comment' \"\$FAKE_DIR/gh/calls.log\""
FAKE_CLAUDE_MODE=report "$RUN" "$(pid_of alpha 4)" >/dev/null 2>&1
"$PRCTL" post alpha#4 --yes --full >/dev/null 2>&1
chk "--full body has False Positives" "grep -q 'False Positives' \"\$FAKE_DIR/gh/last-body.md\""
touch "$FAKE_DIR/gh/review-fail"
FAKE_CLAUDE_MODE=report "$RUN" "$(pid_of alpha 5)" >/dev/null 2>&1
chk "gh failure → exit 1, stays staged" "! \"\$PRCTL\" post alpha#5 --yes >/dev/null 2>&1 && [[ \$(st alpha 5) == staged ]]"
rm -f "$FAKE_DIR/gh/review-fail"
FAKE_CLAUDE_MODE=report "$RUN" "$(pid_of alpha 6)" >/dev/null 2>&1
rm -f "$FAKE_DIR/gh/calls.log"
"$PRCTL" post alpha#6 --yes >/dev/null 2>&1
chk "own PR → forced --comment"       "grep -q -- '--comment' \"\$FAKE_DIR/gh/calls.log\""

# --- summary ---
echo ""
if [[ $fail -eq 0 ]]; then echo "ALL OK"; else echo "FAILURES"; exit 1; fi
